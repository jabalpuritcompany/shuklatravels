+import Breadcrumbs from "@/components/Breadcrumbs";
+import { site } from "@/lib/site";
+import type { Metadata } from "next";
+
+export const metadata: Metadata = { title: "About Shukla Travels", description: "Shukla Travels is a Jabalpur taxi and Madhya Pradesh tour planning company." };
+
+export default function Page() {
+  return (
+    <>
+      <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "About" }]} />
+      <article className="container-st max-w-3xl pb-16 space-y-6">
+        <h1 className="text-3xl font-semibold text-[var(--forest)]">About Shukla Travels</h1>
+        <h2 className="text-xl font-semibold">Who we are</h2>
+        <p>{site.name} is a Jabalpur-based taxi and travel company helping guests with local cabs, outstation cars and Madhya Pradesh tour movements. We do not publish invented years of experience, awards or fleet counts.</p>
+        <h2 className="text-xl font-semibold">Our services</h2>
+        <p>Jabalpur taxi services, MP tour packages, wildlife transfers, pilgrimage and heritage routing, customized tours and corporate travel.</p>
+        <h2 className="text-xl font-semibold">Our approach</h2>
+        <p>Written quotes, honest permit language, and itineraries that respect real driving hours.</p>
+        <h2 className="text-xl font-semibold">Service areas</h2>
+        <p>Jabalpur city and Madhya Pradesh road circuits as quoted. Contact {site.phoneDisplay} · {site.email}</p>
+        <div className="flex flex-wrap gap-2 text-sm">
+          {Object.entries(site.social).map(([k, v]) => <a key={k} href={v} className="underline capitalize">{k}</a>)}
+        </div>
+      </article>
+    </>
+  );
+}
