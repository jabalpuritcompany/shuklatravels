+  taxi: "/assets/images/home/taxi.jpg",
+  kanha: "/assets/images/home/kanha.jpg",
+  bhedaghat: "/assets/images/destinations/bhedaghat.jpg",
+  pachmarhi: "/assets/images/destinations/pachmarhi.jpg",
+  khajuraho: "/assets/images/destinations/khajuraho.jpg",
+  bandhavgarh: "/assets/images/national-parks/bandhavgarh.jpg",
+  innova: "/assets/images/vehicles/innova.jpg",
+} as const;
+
+export function destImage(slug: string) {
+  const map: Record<string, string> = {
+    jabalpur: images.hero,
+    bhedaghat: images.bhedaghat,
+    kanha: images.kanha,
+    bandhavgarh: images.bandhavgarh,
+    pench: images.kanha,
+    pachmarhi: images.pachmarhi,
+    amarkantak: images.pachmarhi,
+    khajuraho: images.khajuraho,
+    orchha: images.khajuraho,
+    ujjain: images.khajuraho,
+    omkareshwar: images.hero,
+    panna: images.bandhavgarh,
+    satpura: images.pachmarhi,
+    bhopal: images.hero,
+    indore: images.hero,
+    gwalior: images.khajuraho,
+    mandu: images.khajuraho,
+    maheshwar: images.hero,
+    sanchi: images.khajuraho,
+    bhimbetka: images.pachmarhi,
+    kuno: images.kanha,
+    chitrakoot: images.hero,
+    maihar: images.khajuraho,
+  };
+  return map[slug] || images.hero;
+}
+
+export function parkImage(slug: string) {
+  if (slug.includes("bandhavgarh")) return images.bandhavgarh;
+  if (slug.includes("pachmarhi") || slug.includes("satpura")) return images.pachmarhi;
+  return images.kanha;
+}
diff --git a/src/lib/schema.ts b/src/lib/schema.ts
new file mode 100644
