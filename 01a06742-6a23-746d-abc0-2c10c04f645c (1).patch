+import { site, waLink } from "@/lib/site";
+import type { Metadata } from "next";
+
+export function generateStaticParams() {
+  return tours.map((t) => ({ category: t.category, slug: t.slug }));
+}
+
+export function generateMetadata({ params }: { params: { slug: string } }): Metadata {
+  const t = getTour(params.slug);
+  if (!t) return {};
+  return { title: `${t.name} from Jabalpur`, description: t.short, alternates: { canonical: `${site.website}/tours/${t.category}/${t.slug}/` } };
+}
+
+export default function Page({ params }: { params: { category: string; slug: string } }) {
+  const t = getTour(params.slug);
+  if (!t || t.category !== params.category) notFound();
+  const cat = tourCategories.find((c) => c.slug === t.category);
+  const url = `${site.website}/tours/${t.category}/${t.slug}/`;
+  return (
+    <>
+      <JsonLd data={webPageSchema(t.name, url, t.short)} />
+      <JsonLd data={breadcrumbSchema([{ name: "Home", url: site.website }, { name: "Tours", url: site.website + "/tours/" }, { name: cat?.name || "", url: site.website + `/tours/${t.category}/` }, { name: t.name, url }])} />
+      {t.faqs.length > 0 && <JsonLd data={faqSchema(t.faqs)} />}
+      <Breadcrumbs items={[{ href: "/", label: "Home" }, { href: "/tours/", label: "Tours" }, { href: `/tours/${t.category}/`, label: cat?.name || t.category }, { label: t.name }]} />
+      <div className="container-st grid gap-10 pb-16 lg:grid-cols-3">
+        <div className="lg:col-span-2 space-y-6">
+          <h1 className="text-3xl font-semibold text-[var(--forest)]">{t.name}</h1>
+          <p>{t.duration} · {t.type} · {t.dest}</p>
+          <p>{t.overview}</p>
+          <h2 className="text-xl font-semibold">Highlights</h2>
+          <ul className="list-disc pl-5">{t.highlights.map((h) => <li key={h}>{h}</li>)}</ul>
+          <h2 className="text-xl font-semibold">Ideal for</h2>
+          <p>{t.ideal.join(", ")}</p>
+          <h2 className="text-xl font-semibold">Day-by-day plan</h2>
+          {t.itinerary.map((i) => <p key={i.day}><strong>{i.day}:</strong> {i.plan}</p>)}
+          <h2 className="text-xl font-semibold">Transportation</h2>
+          <p>Chauffeur-driven vehicle from Jabalpur unless you ask for another start. Vehicle class is confirmed in the quote.</p>
+          <h2 className="text-xl font-semibold">Inclusions</h2>
+          <ul className="list-disc pl-5">{t.includes.map((h) => <li key={h}>{h}</li>)}</ul>
+          <h2 className="text-xl font-semibold">Exclusions</h2>
+          <ul className="list-disc pl-5">{t.excludes.map((h) => <li key={h}>{h}</li>)}</ul>
+          <h2 className="text-xl font-semibold">Best time</h2><p>{t.bestTime}</p>
+          {t.tips.length > 0 && <><h2 className="text-xl font-semibold">Travel tips</h2><ul className="list-disc pl-5">{t.tips.map((h) => <li key={h}>{h}</li>)}</ul></>}
