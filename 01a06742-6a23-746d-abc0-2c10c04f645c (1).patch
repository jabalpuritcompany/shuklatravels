+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+:root {
+  --forest: #1c3d2e;
+  --forest-deep: #12261c;
+  --moss: #2f6b4f;
+  --earth: #8b5e3c;
+  --sand: #f4efe6;
+  --cream: #fbf8f3;
+  --ink: #1a1a17;
+}
+
+html { scroll-behavior: smooth; }
+body {
+  color: var(--ink);
+  background: var(--cream);
+  font-feature-settings: "kern", "liga";
+}
+
+.container-st {
+  @apply mx-auto w-full max-w-6xl px-4 sm:px-6;
+}
+
+.btn {
+  @apply inline-flex items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold transition;
+}
+.btn-primary { @apply bg-[var(--forest)] text-white hover:bg-[var(--forest-deep)]; }
+.btn-accent { @apply bg-[var(--earth)] text-white hover:bg-[#6e4a2f]; }
+.btn-ghost { @apply border border-[var(--forest)] text-[var(--forest)] hover:bg-[var(--sand)]; }
+.btn-wa { @apply bg-[#128C7E] text-white hover:bg-[#0e7368]; }
+
+input, select, textarea {
+  @apply w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm outline-none focus:border-[var(--moss)] focus:ring-1 focus:ring-[var(--moss)];
+}
+label { @apply mb-1 block text-xs font-medium text-stone-600; }
