@@ -0,0 +1,42 @@
+"use client";
+import Link from "next/link";
+import { useMemo, useState } from "react";
+import { destinations } from "@/data/destinations";
+import { parks } from "@/data/parks";
+import { tours } from "@/data/tours";
+import { taxiServices } from "@/data/taxi";
+import { routes } from "@/data/routes";
+import { posts } from "@/data/blog";
+import { faqs } from "@/data/faqs";
+
+export default function Page() {
+  const [q, setQ] = useState("");
+  const query = q.toLowerCase().trim();
+  const match = (s: string) => !query || s.toLowerCase().includes(query);
+  const groups = useMemo(() => [
+    { title: "Tours", items: tours.filter((t) => match(t.name + t.short)).map((t) => ({ href: `/tours/${t.category}/${t.slug}/`, label: t.name })) },
+    { title: "Destinations", items: destinations.filter((d) => match(d.name + d.short)).map((d) => ({ href: `/destinations/${d.slug}/`, label: d.name })) },
+    { title: "National Parks", items: parks.filter((p) => match(p.name)).map((p) => ({ href: `/national-parks/${p.slug}/`, label: p.name })) },
+    { title: "Taxi", items: taxiServices.filter((t) => match(t.name)).map((t) => ({ href: `/taxi-services/${t.slug}/`, label: t.name })) },
+    { title: "Routes", items: routes.filter((r) => match(r.from + r.to)).map((r) => ({ href: `/routes/${r.slug}/`, label: `${r.from} to ${r.to}` })) },
+    { title: "Blog", items: posts.filter((p) => match(p.title)).map((p) => ({ href: `/blog/${p.slug}/`, label: p.title })) },
+    { title: "FAQs", items: faqs.filter((f) => match(f.q)).map((f) => ({ href: "/faq/", label: f.q })) },
+  ], [query]);
+
+  return (
+    <div className="container-st py-12">
+      <h1 className="text-3xl font-semibold">Search</h1>
+      <form className="mt-4 flex gap-2" onSubmit={(e) => e.preventDefault()}>
+        <input value={q} onChange={(e) => setQ(e.target.value)} placeholder="Tours, destinations, parks…" />
+        <button className="btn btn-primary" type="submit">Search</button>
+      </form>
+      {query && groups.map((g) => (
+        <section key={g.title} className="mt-8">
+          <h2 className="font-semibold text-[var(--forest)]">{g.title}</h2>
+          <ul className="mt-2">{g.items.slice(0, 8).map((i) => <li key={i.href + i.label}><Link className="underline" href={i.href}>{i.label}</Link></li>)}</ul>
+          {g.items.length === 0 && <p className="text-sm text-stone-500">No matches.</p>}
+        </section>
+      ))}
+    </div>
+  );
+}
