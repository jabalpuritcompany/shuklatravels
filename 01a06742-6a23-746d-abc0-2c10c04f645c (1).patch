+import type { MetadataRoute } from "next";
+import { site } from "@/lib/site";
+import { destinations } from "@/data/destinations";
+import { parks } from "@/data/parks";
+import { tours, tourCategories } from "@/data/tours";
+import { taxiServices } from "@/data/taxi";
+import { routes } from "@/data/routes";
+import { vehicles } from "@/data/vehicles";
+import { posts } from "@/data/blog";
+
+export default function sitemap(): MetadataRoute.Sitemap {
+  const u = (path: string) => ({ url: `${site.website}${path}`, lastModified: new Date() });
+  return [
+    u("/"),
+    u("/tours/"),
+    u("/destinations/"),
+    u("/national-parks/"),
+    u("/taxi-services/"),
+    u("/vehicles/"),
+    u("/routes/"),
+    u("/corporate/"),
+    u("/about-us/"),
+    u("/contact-us/"),
+    u("/faq/"),
+    u("/blog/"),
+    u("/plan-your-trip/"),
+    u("/build-your-tour/"),
+    u("/privacy-policy/"),
+    u("/terms-and-conditions/"),
+    u("/cancellation-refund-policy/"),
+    u("/disclaimer/"),
+    u("/cookie-policy/"),
+    ...tourCategories.map((c) => u(`/tours/${c.slug}/`)),
+    ...tours.map((t) => u(`/tours/${t.category}/${t.slug}/`)),
+    ...destinations.map((d) => u(`/destinations/${d.slug}/`)),
+    ...parks.map((p) => u(`/national-parks/${p.slug}/`)),
+    ...taxiServices.map((t) => u(`/taxi-services/${t.slug}/`)),
+    ...routes.map((r) => u(`/routes/${r.slug}/`)),
+    ...vehicles.map((v) => u(`/vehicles/${v.slug}/`)),
+    ...posts.map((p) => u(`/blog/${p.slug}/`)),
+  ];
+}
