+"use client";
+import Breadcrumbs from "@/components/Breadcrumbs";
+import { destinations } from "@/data/destinations";
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+
+export default function Page() {
+  const [stops, setStops] = useState<string[]>(["jabalpur"]);
+  const [add, setAdd] = useState("bhedaghat");
+  const router = useRouter();
+  function move(i: number, dir: number) {
+    const j = i + dir;
+    if (j < 0 || j >= stops.length) return;
+    const n = [...stops];
+    [n[i], n[j]] = [n[j], n[i]];
+    setStops(n);
+  }
+  async function onSubmit(e: React.FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    const fd = new FormData(e.currentTarget);
+    const payload: Record<string, string> = { tripType: "custom", context: "build-tour", destination: stops.join(" → ") };
+    fd.forEach((v, k) => { payload[k] = String(v); });
+    payload.message = `${payload.message || ""}\nRoute: ${stops.join(" → ")}`;
+    const res = await fetch("/enquiry.php", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
+    if (res.ok) router.push("/thank-you/");
+  }
+  return (
+    <>
+      <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "Build tour" }]} />
+      <div className="container-st max-w-2xl pb-16">
+        <h1 className="text-3xl font-semibold text-[var(--forest)]">Build your own MP tour</h1>
+        <p className="mt-2">Add, remove and reorder destinations, then request a custom quote.</p>
+        <ol className="mt-6 space-y-2">
+          {stops.map((s, i) => (
+            <li key={s + i} className="flex items-center justify-between rounded-lg border bg-white px-3 py-2">
+              <span className="capitalize">{s.replace(/-/g, " ")}</span>
+              <span className="flex gap-2 text-sm">
+                <button type="button" onClick={() => move(i, -1)}>Up</button>
+                <button type="button" onClick={() => move(i, 1)}>Down</button>
+                <button type="button" onClick={() => setStops(stops.filter((_, x) => x !== i))}>Remove</button>
+              </span>
+            </li>
+          ))}
+        </ol>
+        <div className="mt-4 flex gap-2">
+          <select value={add} onChange={(e) => setAdd(e.target.value)} className="flex-1">
+            {destinations.map((d) => <option key={d.slug} value={d.slug}>{d.name}</option>)}
+          </select>
+          <button type="button" className="btn btn-ghost" onClick={() => setStops([...stops, add])}>Add destination</button>
+        </div>
+        <form onSubmit={onSubmit} className="mt-8 grid gap-3 sm:grid-cols-2">
+          <div><label>Name</label><input name="name" required /></div>
+          <div><label>Mobile</label><input name="mobile" required /></div>
+          <div><label>Email</label><input name="email" type="email" /></div>
+          <div><label>Travel date</label><input name="travelDate" type="date" /></div>
+          <div><label>Travellers</label><input name="adults" type="number" /></div>
+          <div><label>Nights</label><input name="days" type="number" /></div>
+          <div><label>Vehicle</label><select name="vehicle"><option>SUV</option><option>Innova / Crysta</option><option>Sedan</option><option>Tempo Traveller</option></select></div>
+          <div><label>Safari needed?</label><select name="service"><option>No</option><option>Yes</option></select></div>
+          <div className="sm:col-span-2"><label>Special requests</label><textarea name="message" rows={3} /></div>
+          <button className="btn btn-primary sm:col-span-2" type="submit">Request custom quote</button>
+        </form>
+      </div>
+    </>
+  );
+}
