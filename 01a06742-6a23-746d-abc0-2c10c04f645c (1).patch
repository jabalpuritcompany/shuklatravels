@@ -0,0 +1,88 @@
+"use client";
+import { useState } from "react";
+import { useRouter } from "next/navigation";
+
+const vehicles = ["Sedan", "SUV", "Innova / Crysta", "Tempo Traveller", "No preference"];
+
+export default function BookingForm({
+  context,
+  defaultDestination,
+  defaultPackage,
+  defaultService,
+  defaultRoute,
+}: {
+  context?: string;
+  defaultDestination?: string;
+  defaultPackage?: string;
+  defaultService?: string;
+  defaultRoute?: string;
+}) {
+  const [tab, setTab] = useState<"taxi" | "tour" | "custom">("taxi");
+  const [status, setStatus] = useState("");
+  const router = useRouter();
+
+  async function onSubmit(e: React.FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    setStatus("Sending…");
+    const fd = new FormData(e.currentTarget);
+    const payload: Record<string, string> = { tripType: tab, context: context || "" };
+    fd.forEach((v, k) => { payload[k] = String(v); });
+    const res = await fetch("/enquiry.php", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(payload),
+    });
+    if (res.ok) router.push("/thank-you/");
+    else setStatus("Could not send. Please call or WhatsApp.");
+  }
+
+  const field = (name: string, label: string, type = "text", extra: Record<string, string> = {}) => (
+    <div>
+      <label htmlFor={name}>{label}</label>
+      <input id={name} name={name} type={type} {...extra} />
+    </div>
+  );
+
+  return (
+    <div className="rounded-2xl border border-stone-200 bg-white p-4 shadow-sm sm:p-6" id="book">
+      <div className="mb-4 flex gap-2">
+        {(["taxi", "tour", "custom"] as const).map((t) => (
+          <button key={t} type="button" onClick={() => setTab(t)} className={`rounded-full px-3 py-1 text-sm capitalize ${tab === t ? "bg-[var(--forest)] text-white" : "bg-[var(--sand)]"}`}>
+            {t === "taxi" ? "Taxi booking" : t === "tour" ? "Tour enquiry" : "Custom trip"}
+          </button>
+        ))}
+      </div>
+      <form onSubmit={onSubmit} className="grid gap-3 sm:grid-cols-2">
+        {field("name", "Full name", "text", { required: "true" })}
+        {field("mobile", "Mobile", "tel", { required: "true" })}
+        {field("email", "Email", "email")}
+        {field("pickup", "Pickup")}
+        {field("drop", "Drop")}
+        {field("travelDate", "Travel date", "date")}
+        {field("returnDate", "Return date", "date")}
+        {field("adults", "Adults", "number")}
+        {field("children", "Children", "number")}
+        <div>
+          <label htmlFor="vehicle">Vehicle</label>
+          <select id="vehicle" name="vehicle" defaultValue="">
+            <option value="">Select</option>
+            {vehicles.map((v) => <option key={v}>{v}</option>)}
+          </select>
+        </div>
+        {field("destination", "Destination", "text", { defaultValue: defaultDestination || "" })}
+        {field("packageName", "Tour package", "text", { defaultValue: defaultPackage || "" })}
+        {field("service", "Service", "text", { defaultValue: defaultService || "" })}
+        {field("route", "Route", "text", { defaultValue: defaultRoute || "" })}
+        {field("days", "Number of days", "number")}
+        <div className="sm:col-span-2">
+          <label htmlFor="message">Message</label>
+          <textarea id="message" name="message" rows={3} />
+        </div>
+        <div className="sm:col-span-2">
+          <button className="btn btn-primary" type="submit">Request quote</button>
+          {status && <p className="mt-2 text-sm">{status}</p>}
+        </div>
+      </form>
+    </div>
+  );
+}
