+      <div className="relative h-64 md:h-80">
+        <Image src={destImage(d.slug)} alt={d.name} fill priority className="object-cover" />
+        <div className="absolute inset-0 bg-black/40" />
+        <div className="container-st relative z-10 flex h-full flex-col justify-end pb-8 text-white">
+          <h1 className="text-4xl font-semibold">{d.name}</h1>
+          <p>{d.short}</p>
+        </div>
+      </div>
+      <Breadcrumbs items={[{ href: "/", label: "Home" }, { href: "/destinations/", label: "Destinations" }, { label: d.name }]} />
+      <article className="container-st grid gap-10 pb-16 lg:grid-cols-3">
+        <div className="prose-st lg:col-span-2 space-y-8">
+          <section><h2 className="text-xl font-semibold text-[var(--forest)]">Overview</h2><p className="mt-2 text-stone-700">{d.overview}</p></section>
+          <section><h2 className="text-xl font-semibold text-[var(--forest)]">Why visit</h2><ul className="mt-2 list-disc pl-5">{d.why.map((w) => <li key={w}>{w}</li>)}</ul></section>
+          <section><h2 className="text-xl font-semibold text-[var(--forest)]">Top attractions</h2><ul className="mt-2 list-disc pl-5">{d.attractions.map((w) => <li key={w}>{w}</li>)}</ul></section>
+          <section><h2 className="text-xl font-semibold text-[var(--forest)]">Things to do</h2><ul className="mt-2 list-disc pl-5">{d.things.map((w) => <li key={w}>{w}</li>)}</ul></section>
+          <section><h2 className="text-xl font-semibold text-[var(--forest)]">Best time to visit</h2><p className="mt-2">{d.bestTime}</p></section>
+          <section><h2 className="text-xl font-semibold text-[var(--forest)]">How to reach</h2><p className="mt-2">{d.howToReach}</p></section>
+          <section><h2 className="text-xl font-semibold text-[var(--forest)]">Jabalpur connection</h2><p className="mt-2">{d.jabalpur}</p></section>
+          <section>
+            <h2 className="text-xl font-semibold text-[var(--forest)]">Suggested itinerary</h2>
+            {d.itinerary.map((i) => <p key={i.day} className="mt-2"><strong>{i.day}:</strong> {i.plan}</p>)}
+          </section>
+          <section>
+            <h2 className="text-xl font-semibold text-[var(--forest)]">Taxi options</h2>
+            <p className="mt-2">Request a Jabalpur taxi, outstation car or sightseeing cab for {d.name}.</p>
+            <Link href="/taxi-services/jabalpur-taxi-service/" className="text-[var(--moss)] underline">Jabalpur taxi service</Link>
+          </section>
+          {relatedTours.length > 0 && (
+            <section>
+              <h2 className="text-xl font-semibold text-[var(--forest)]">Tour packages</h2>
+              <ul className="mt-2">{relatedTours.map((t) => <li key={t.slug}><Link href={`/tours/${t.category}/${t.slug}/`} className="underline">{t.name}</Link></li>)}</ul>
+            </section>
+          )}
+          {relatedRoutes.length > 0 && (
+            <section>
+              <h2 className="text-xl font-semibold text-[var(--forest)]">Routes from Jabalpur</h2>
+              {relatedRoutes.map((r) => <p key={r.slug}><Link href={`/routes/${r.slug}/`} className="underline">{r.from} to {r.to}</Link></p>)}
+            </section>
+          )}
+          <section>
+            <h2 className="text-xl font-semibold text-[var(--forest)]">Nearby destinations</h2>
+            <div className="mt-2 flex flex-wrap gap-2">
+              {destinations.filter((x) => x.slug !== d.slug).slice(0, 6).map((x) => (
+                <Link key={x.slug} href={`/destinations/${x.slug}/`} className="rounded-full bg-[var(--sand)] px-3 py-1 text-sm">{x.name}</Link>
+              ))}
+            </div>
+          </section>
+          <section>
+            <h2 className="text-xl font-semibold text-[var(--forest)]">FAQs</h2>
