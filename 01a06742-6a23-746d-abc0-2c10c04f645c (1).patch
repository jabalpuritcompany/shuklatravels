+"use client";
+import Breadcrumbs from "@/components/Breadcrumbs";
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+
+export default function Page() {
+  const [status, setStatus] = useState("");
+  const router = useRouter();
+  async function onSubmit(e: React.FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    const fd = new FormData(e.currentTarget);
+    const payload: Record<string, string> = { tripType: "plan", context: "plan-your-trip" };
+    fd.forEach((v, k) => { payload[k] = String(v); });
+    const res = await fetch("/enquiry.php", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
+    if (res.ok) router.push("/thank-you/");
+    else setStatus("Please call or WhatsApp.");
+  }
+  return (
+    <>
+      <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "Plan your trip" }]} />
+      <div className="container-st max-w-2xl pb-16">
+        <h1 className="text-3xl font-semibold text-[var(--forest)]">Plan your MP trip</h1>
+        <p className="mt-2 text-stone-600">Get my custom itinerary — we reply with a planning outline, not an instant auto-price.</p>
+        <form onSubmit={onSubmit} className="mt-6 grid gap-3 sm:grid-cols-2">
+          {[
+            ["name", "Full name"],
+            ["mobile", "Mobile"],
+            ["email", "Email"],
+            ["pickup", "Starting location"],
+            ["destination", "Destination"],
+            ["travelDate", "Travel date", "date"],
+            ["returnDate", "Return date", "date"],
+            ["adults", "Adults", "number"],
+            ["children", "Children", "number"],
+            ["days", "Number of days", "number"],
+          ].map(([n, l, ty]) => (
+            <div key={n}><label htmlFor={n}>{l}</label><input id={n} name={n} type={ty || "text"} required={n === "name" || n === "mobile"} /></div>
+          ))}
+          <div><label>Vehicle preference</label><select name="vehicle"><option>No preference</option><option>Sedan</option><option>SUV</option><option>Innova / Crysta</option><option>Tempo Traveller</option></select></div>
+          <div><label>Tour type</label><select name="packageName"><option>Wildlife</option><option>Family</option><option>Pilgrimage</option><option>Heritage</option><option>Mix</option></select></div>
+          <div><label>Safari required?</label><select name="service"><option>Not sure</option><option>Yes</option><option>No</option></select></div>
+          <div><label>Accommodation required?</label><select name="route"><option>Advise me</option><option>Yes</option><option>No — transport only</option></select></div>
+          <div className="sm:col-span-2"><label>Special requirements</label><textarea name="message" rows={4} /></div>
+          <button className="btn btn-primary sm:col-span-2" type="submit">Get my custom itinerary</button>
+          {status && <p>{status}</p>}
+        </form>
+      </div>
+    </>
+  );
+}
