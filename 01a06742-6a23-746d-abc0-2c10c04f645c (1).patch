+          {[
+            ["Overview", p.overview],
+            ["Safari information", p.safari],
+            ["Best time to visit", p.bestTime],
+            ["How to reach", p.howToReach],
+            ["Jabalpur connectivity", p.jabalpur],
+            ["Suggested duration", p.duration],
