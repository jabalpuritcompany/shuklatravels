diff --git a/public_html/enquiry.php b/public_html/enquiry.php
new file mode 100644
index 0000000..a7f8c52
--- /dev/null
+++ b/public_html/enquiry.php
@@ -0,0 +1,71 @@
+<?php
+header('Content-Type: application/json; charset=utf-8');
+header('X-Content-Type-Options: nosniff');
+
+if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
+  http_response_code(405);
+  echo json_encode(['error' => 'Method not allowed']);
+  exit;
+}
+
+$raw = file_get_contents('php://input');
+$data = json_decode($raw, true);
+if (!is_array($data)) {
+  $data = $_POST;
+}
+
+$name = trim(substr((string)($data['name'] ?? ''), 0, 120));
+$mobile = trim(substr((string)($data['mobile'] ?? ''), 0, 30));
+if ($name === '' || $mobile === '') {
+  http_response_code(400);
+  echo json_encode(['error' => 'Name and mobile required']);
+  exit;
+}
+
+$enquiry = [
+  'id' => 'ST-' . date('YmdHis') . '-' . substr(bin2hex(random_bytes(3)), 0, 6),
+  'name' => $name,
+  'mobile' => $mobile,
+  'email' => substr((string)($data['email'] ?? ''), 0, 160),
+  'pickup' => substr((string)($data['pickup'] ?? ''), 0, 200),
+  'drop' => substr((string)($data['drop'] ?? ''), 0, 200),
+  'travelDate' => substr((string)($data['travelDate'] ?? ''), 0, 40),
+  'returnDate' => substr((string)($data['returnDate'] ?? ''), 0, 40),
+  'adults' => substr((string)($data['adults'] ?? ''), 0, 10),
+  'children' => substr((string)($data['children'] ?? ''), 0, 10),
+  'vehicle' => substr((string)($data['vehicle'] ?? ''), 0, 80),
+  'destination' => substr((string)($data['destination'] ?? ''), 0, 200),
+  'packageName' => substr((string)($data['packageName'] ?? ''), 0, 200),
+  'tripType' => substr((string)($data['tripType'] ?? ''), 0, 40),
+  'days' => substr((string)($data['days'] ?? ''), 0, 10),
+  'message' => substr((string)($data['message'] ?? ''), 0, 4000),
+  'service' => substr((string)($data['service'] ?? ''), 0, 200),
+  'route' => substr((string)($data['route'] ?? ''), 0, 200),
+  'context' => substr((string)($data['context'] ?? ''), 0, 200),
+  'status' => 'New',
+  'createdAt' => date('c'),
+];
+
+$dir = __DIR__ . '/data';
+if (!is_dir($dir)) {
+  mkdir($dir, 0755, true);
+}
+$file = $dir . '/enquiries.json';
+$list = [];
+if (is_file($file)) {
+  $list = json_decode((string)file_get_contents($file), true) ?: [];
+}
+array_unshift($list, $enquiry);
+file_put_contents($file, json_encode($list, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE), LOCK_EX);
+
+$to = 'shuklatravelsjabalpur@gmail.com';
+$subject = 'New enquiry ' . $enquiry['id'] . ' — ' . $enquiry['name'];
+$rows = '';
+foreach ($enquiry as $k => $v) {
+  $rows .= '<tr><td style="padding:6px;color:#666">' . htmlspecialchars($k) . '</td><td style="padding:6px">' . nl2br(htmlspecialchars((string)$v)) . '</td></tr>';
+}
+$html = '<div style="font-family:Georgia,serif;background:#f4efe6;padding:24px"><div style="max-width:560px;margin:auto;background:#fff;padding:24px;border-radius:12px"><h1 style="color:#1c3d2e">Shukla Travels enquiry</h1><table style="width:100%;font-size:14px">' . $rows . '</table></div></div>';
+$headers = "MIME-Version: 1.0\r\nContent-type: text/html; charset=UTF-8\r\nFrom: Shukla Travels <noreply@shuklatravelsindia.com>\r\nReply-To: " . $enquiry['email'] . "\r\n";
+@mail($to, $subject, $html, $headers);
+
+echo json_encode(['ok' => true, 'id' => $enquiry['id']]);
