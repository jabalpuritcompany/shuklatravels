+import { tours } from "@/data/tours";
+import { routes } from "@/data/routes";
+import type { Metadata } from "next";
+
+export function generateStaticParams() {
+  return destinations.map((d) => ({ slug: d.slug }));
+}
+
+export function generateMetadata({ params }: { params: { slug: string } }): Metadata {
+  const d = getDestination(params.slug);
+  if (!d) return {};
+  return {
+    title: `${d.name} Travel from Jabalpur`,
+    description: d.short,
+    alternates: { canonical: `${site.website}/destinations/${d.slug}/` },
+  };
+}
+
+export default function Page({ params }: { params: { slug: string } }) {
+  const d = getDestination(params.slug);
+  if (!d) notFound();
+  const relatedTours = tours.filter((t) => t.relatedDest.includes(d.slug));
+  const relatedRoutes = routes.filter((r) => r.toSlug === d.slug);
+  const url = `${site.website}/destinations/${d.slug}/`;
+  return (
+    <>
+      <JsonLd data={webPageSchema(d.name, url, d.short)} />
+      <JsonLd data={breadcrumbSchema([{ name: "Home", url: site.website }, { name: "Destinations", url: site.website + "/destinations/" }, { name: d.name, url }])} />
+      <JsonLd data={faqSchema(d.faqs)} />
