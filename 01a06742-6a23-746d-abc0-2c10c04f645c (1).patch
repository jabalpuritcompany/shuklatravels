+import { notFound } from "next/navigation";
+import Link from "next/link";
+import { routes, getRoute } from "@/data/routes";
+import Breadcrumbs from "@/components/Breadcrumbs";
+import BookingForm from "@/components/BookingForm";
+import JsonLd from "@/components/JsonLd";
+import { breadcrumbSchema, faqSchema, webPageSchema } from "@/lib/schema";
+import { site, waLink } from "@/lib/site";
+import { tours } from "@/data/tours";
+import type { Metadata } from "next";
+
+export function generateStaticParams() {
+  return routes.map((r) => ({ slug: r.slug }));
+}
+
+export function generateMetadata({ params }: { params: { slug: string } }): Metadata {
+  const r = getRoute(params.slug);
+  if (!r) return {};
+  return { title: `${r.from} to ${r.to} Taxi | One Way & Round Trip`, description: r.overview, alternates: { canonical: `${site.website}/routes/${r.slug}/` } };
+}
+
+export default function Page({ params }: { params: { slug: string } }) {
+  const r = getRoute(params.slug);
+  if (!r) notFound();
+  const url = `${site.website}/routes/${r.slug}/`;
+  return (
+    <>
+      <JsonLd data={webPageSchema(`${r.from} to ${r.to}`, url, r.overview)} />
+      <JsonLd data={breadcrumbSchema([{ name: "Home", url: site.website }, { name: "Routes", url: site.website + "/routes/" }, { name: `${r.from} to ${r.to}`, url }])} />
+      <JsonLd data={faqSchema(r.faqs)} />
+      <Breadcrumbs items={[{ href: "/", label: "Home" }, { href: "/routes/", label: "Routes" }, { label: `${r.from} to ${r.to}` }]} />
+      <div className="container-st grid gap-10 pb-16 lg:grid-cols-3">
+        <div className="lg:col-span-2 space-y-4">
+          <h1 className="text-3xl font-semibold text-[var(--forest)]">{r.from} to {r.to} taxi</h1>
+          <p>{r.overview}</p>
+          <table className="w-full text-sm border"><tbody>
+            <tr><td className="border p-2 font-medium">Distance</td><td className="border p-2">{r.distance}</td></tr>
+            <tr><td className="border p-2 font-medium">Travel time</td><td className="border p-2">{r.time}</td></tr>
+            <tr><td className="border p-2 font-medium">Road</td><td className="border p-2">{r.road}</td></tr>
+            <tr><td className="border p-2 font-medium">Vehicle</td><td className="border p-2">{r.vehicle}</td></tr>
+          </tbody></table>
+          <h2 className="text-xl font-semibold">Suggested stops</h2>
+          <ul className="list-disc pl-5">{r.stops.map((s) => <li key={s}>{s}</li>)}</ul>
+          <h2 className="text-xl font-semibold">Suggested itinerary</h2>
+          <p>{r.itinerary}</p>
+          <p>One-way and round-trip taxis are both available. Tour options: {tours.filter((t) => t.relatedDest.includes(r.toSlug)).map((t) => <Link key={t.slug} className="mr-2 underline" href={`/tours/${t.category}/${t.slug}/`}>{t.name}</Link>)}</p>
+          <p>Destination guide: <Link className="underline" href={`/destinations/${r.toSlug}/`}>{r.to}</Link></p>
+          {r.faqs.map((f) => <details key={f.q} className="border p-3 bg-white"><summary>{f.q}</summary><p className="text-sm mt-1">{f.a}</p></details>)}
+          <a className="btn btn-wa" href={waLink(`Hello Shukla Travels, I would like to enquire about a ${r.from} to ${r.to} trip.`)}>WhatsApp this route</a>
+        </div>
+        <BookingForm context={`route:${r.slug}`} defaultRoute={`${r.from} to ${r.to}`} defaultDestination={r.to} />
+      </div>
+    </>
+  );
+}
