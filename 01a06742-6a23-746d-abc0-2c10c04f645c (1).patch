diff --git a/public/booking-admin.php b/public/booking-admin.php
new file mode 100644
index 0000000..19307a2
--- /dev/null
+++ b/public/booking-admin.php
@@ -0,0 +1,102 @@
+<?php
+session_start();
+$ADMIN_USER = 'admin';
+$ADMIN_PASS = 'Shukla@2026'; // change after first login
+$file = __DIR__ . '/data/enquiries.json';
+
+if (isset($_GET['logout'])) {
+  session_destroy();
+  header('Location: /booking-admin.php');
+  exit;
+}
+
+if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['login'])) {
+  if (hash_equals($ADMIN_USER, (string)$_POST['user']) && hash_equals($ADMIN_PASS, (string)$_POST['pass'])) {
+    $_SESSION['st_admin'] = true;
+    header('Location: /booking-admin.php');
+    exit;
+  }
+  $error = 'Invalid login';
+}
+
+if (isset($_SESSION['st_admin']) && $_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['id'], $_POST['status'])) {
+  $allowed = ['New','Contacted','Quote Sent','Confirmed','Completed','Cancelled'];
+  $list = is_file($file) ? (json_decode((string)file_get_contents($file), true) ?: []) : [];
+  foreach ($list as &$row) {
+    if (($row['id'] ?? '') === $_POST['id'] && in_array($_POST['status'], $allowed, true)) {
+      $row['status'] = $_POST['status'];
+    }
+  }
+  file_put_contents($file, json_encode($list, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE), LOCK_EX);
+  header('Location: /booking-admin.php');
+  exit;
+}
+
+if (isset($_SESSION['st_admin']) && isset($_GET['export']) && $_GET['export'] === 'csv') {
+  $list = is_file($file) ? (json_decode((string)file_get_contents($file), true) ?: []) : [];
+  header('Content-Type: text/csv');
+  header('Content-Disposition: attachment; filename="enquiries.csv"');
+  $out = fopen('php://output', 'w');
+  fputcsv($out, ['id','name','mobile','email','destination','status','createdAt']);
+  foreach ($list as $r) {
+    fputcsv($out, [$r['id']??'',$r['name']??'',$r['mobile']??'',$r['email']??'',$r['destination']??'',$r['status']??'',$r['createdAt']??'']);
+  }
+  fclose($out);
+  exit;
+}
+
+$list = is_file($file) ? (json_decode((string)file_get_contents($file), true) ?: []) : [];
+?><!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="robots" content="noindex,nofollow">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Booking admin — Shukla Travels</title>
+  <style>
+    body{font-family:system-ui,sans-serif;background:#fbf8f3;color:#1a1a17;margin:0;padding:24px}
+    input,select{padding:8px;border:1px solid #ccc;border-radius:8px}
+    table{width:100%;border-collapse:collapse;background:#fff;margin-top:16px}
+    th,td{border:1px solid #e5e0d6;padding:8px;font-size:14px;vertical-align:top}
+    .btn{background:#1c3d2e;color:#fff;border:0;padding:8px 14px;border-radius:999px;cursor:pointer}
+    a{color:#1c3d2e}
+  </style>
+</head>
