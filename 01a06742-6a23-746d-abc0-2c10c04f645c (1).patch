+import type { Metadata } from "next";
+import localFont from "next/font/local";
+import "./globals.css";
+import Header from "@/components/Header";
+import Footer from "@/components/Footer";
+import MobileBar from "@/components/MobileBar";
+import JsonLd from "@/components/JsonLd";
+import { orgSchema } from "@/lib/schema";
+import { site } from "@/lib/site";
+
+const geistSans = localFont({
+  src: "./fonts/GeistVF.woff",
+  variable: "--font-geist-sans",
+  weight: "100 900",
+});
+
+export const metadata: Metadata = {
+  metadataBase: new URL(site.website),
+  title: {
+    default: "Jabalpur Taxi Service | MP Tour Packages | Shukla Travels",
+    template: "%s | Shukla Travels",
+  },
+  description: site.tagline,
+  openGraph: {
+    siteName: site.name,
+    type: "website",
+    images: [site.logo],
+  },
+  icons: { icon: site.logo },
+};
+
+export default function RootLayout({ children }: { children: React.ReactNode }) {
+  return (
+    <html lang="en">
+      <body className={`${geistSans.variable} pb-16 font-sans antialiased md:pb-0`}>
+        <a href="#main" className="sr-only focus:not-sr-only">Skip to content</a>
+        <JsonLd data={orgSchema} />
+        <JsonLd data={{ "@context": "https://schema.org", "@type": "WebSite", name: site.name, url: site.website, potentialAction: { "@type": "SearchAction", target: site.website + "/search/?q={query}", "query-input": "required name=query" } }} />
+        <Header />
+        <main id="main">{children}</main>
+        <Footer />
+        <MobileBar />
+      </body>
+    </html>
