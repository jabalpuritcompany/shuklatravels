+import Link from "next/link";
+import { posts } from "@/data/blog";
+import Breadcrumbs from "@/components/Breadcrumbs";
+import type { Metadata } from "next";
+
+export const metadata: Metadata = { title: "Travel Guide & Blog", description: "Jabalpur travel, MP tourism, wildlife and taxi guides from Shukla Travels." };
+
+export default function Page() {
+  const cats = Array.from(new Set(posts.map((p) => p.category)));
+  return (
+    <>
+      <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "Blog" }]} />
+      <div className="container-st pb-16">
+        <h1 className="text-3xl font-semibold text-[var(--forest)]">Travel guide</h1>
+        <p className="mt-2 text-sm text-stone-500">Categories: {cats.join(" · ")}</p>
+        <div className="mt-8 grid gap-4 md:grid-cols-2">
+          {posts.map((p) => (
+            <Link key={p.slug} href={`/blog/${p.slug}/`} className="rounded-xl border bg-white p-5">
+              <p className="text-xs">{p.category} · {p.date}</p>
+              <h2 className="font-semibold">{p.title}</h2>
+              <p className="text-sm text-stone-600">{p.excerpt}</p>
+            </Link>
+          ))}
+        </div>
+      </div>
+    </>
+  );
+}
